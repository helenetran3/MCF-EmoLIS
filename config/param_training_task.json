{
  "task":
  {
    "model_name": ["mfn", "mult"],
    "label_type": ["all", "present"],
    "set_length": 56,
    "thres_score_pres": 0,
    "predict_neutral_class": 0,
    "align_to_text": 1,
    "image_feature": "facet",
    "thres_nan": 0,
    "replace_nan": "linear_1d",
    "with_custom_split": 0
  },

  "training":
  {
    "num_epochs": 30,
    "patience": 8,
    "batch_size": 32,
    "optimizer": "adam",
    "loss_function": ["mse", "wei_bce"],
    "val_metrics": ["mse", "wei_bce"],
    "coef_coa": 0.6,
    "bilevel_opt": 1,
    "num_steps_bilevel": 10,
    "thres_ml_from_best_metric": 1,
    "learning_rate": 5e-4,
    "cross_val_folds": 5,
    "random_state": 42,
    "clip": 2,
    "when": -1
  }
}
